<CanvasWidget xmlns="runtime-namespace:Game">

	<CanvasWidget Size="500, 300" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">

		<RectangleWidget FillColor="0, 0, 0, 255" OutlineColor="128, 128, 128, 128" OutlineThickness="2" />

		<StackPanelWidget Direction="Vertical" Margin="20, 15" IsVisible="true">

			<LabelWidget Text="季节系统设置" FontScale="1.2" HorizontalAlignment="Center" Margin="0, 0, 0, 15" />

			<StackPanelWidget Direction="Vertical" Margin="0, 0, 0, 20">
				<LabelWidget Text="游戏规则:" Color="128, 128, 128" FontScale="0.9" Margin="0, 0, 0, 5" />
				<LabelWidget Text="• 简单模式: 从夏季开始" Color="128, 128, 128" FontScale="0.8" Margin="0, 2" />
				<LabelWidget Text="• 困难模式: 从冬季开始" Color="128, 128, 128" FontScale="0.8" Margin="0, 2" />
				<LabelWidget Text="• 每季时长: 8-64天，默认16天" Color="128, 128, 128" FontScale="0.8" Margin="0, 2" />
				<LabelWidget Text="• 设置后仅第一天可修改" Color="128, 128, 128" FontScale="0.8" Margin="0, 2" />
			</StackPanelWidget>

			<StackPanelWidget Direction="Vertical" Margin="0, 0, 0, 25">
				<LabelWidget Name="SeasonSliderLabel" Text="每季天数: 16" HorizontalAlignment="Center" Margin="0, 0, 0, 5" />
				<SliderWidget Name="SeasonSlider" HorizontalAlignment="Center" Size="400, 30" />
			</StackPanelWidget>

			<BevelledButtonWidget Style="{Styles/ButtonStyle_160x60}" HorizontalAlignment="Center" Name="OkButton" Text="确认设置" />

		</StackPanelWidget>

	</CanvasWidget>

</CanvasWidget>