<CanvasWidget xmlns="runtime-namespace:Game">

	<CanvasWidget Size="600, 400" ClampToBounds="true" HorizontalAlignment="Center" VerticalAlignment="Center">

		<RectangleWidget FillColor="0, 0, 0, 255" OutlineColor="128, 128, 128, 128" OutlineThickness="2" />

		<StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" Margin="10, 0" IsVisible="true">

			<StackPanelWidget Direction="Vertical">

				<StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
					<LabelWidget Text="说明" HorizontalAlignment="Center" Margin="0, 15" />
						<LabelWidget Text="开局出生点为简单，则起始季节为夏季，" Color="0, 128, 0" HorizontalAlignment="Center" Margin="0, 0" />
						<LabelWidget Text="若为困难，则起始季节为冬季。"  Color="128, 0, 0" HorizontalAlignment="Center" Margin="0, 0" />
						<LabelWidget Text=" "  Color="128, 128, 128" HorizontalAlignment="Center" Margin="0, 0" />
						<LabelWidget Text="游戏开始的第一天可以选择季节周期，" Color="64, 64, 64" HorizontalAlignment="Center" Margin="0, 0" />
						<LabelWidget Text="不选默认一季16天，一天后不可更改。"  Color="128, 0, 0" HorizontalAlignment="Center" Margin="0, 0" />
				</StackPanelWidget>

				<CanvasWidget Size="Infinity, Infinity" VerticalAlignment="Center">
					<StackPanelWidget Direction="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
						<StackPanelWidget Margin="0, 2">
							<CanvasWidget Size="100, 50" VerticalAlignment="Center">
								<LabelWidget Text="选择季周期:"  VerticalAlignment="Center" Color="128, 128, 128" Margin="30, 0"/>
							</CanvasWidget>
							<CanvasWidget Size="450, 50" VerticalAlignment="Center" >
								<SliderWidget Name="SeasonSlider" VerticalAlignment="Center" Margin="60, 0"/>
							</CanvasWidget>
						</StackPanelWidget>
					</StackPanelWidget>
				</CanvasWidget>

			</StackPanelWidget>

			<UniformSpacingPanelWidget Direction="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10, 15">
				<BevelledButtonWidget Style="{Styles/ButtonStyle_160x60}" HorizontalAlignment="Center" Name="OkButton" Text="确定" />
			</UniformSpacingPanelWidget>

		</StackPanelWidget>

	</CanvasWidget>

</CanvasWidget>