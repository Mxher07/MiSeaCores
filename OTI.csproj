<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SurvivalcraftAPI.Engine" Version="1.8.1.2" />
    <PackageReference Include="SurvivalcraftAPI.EntitySystem" Version="1.8.1.2" />
    <PackageReference Include="SurvivalcraftAPI.Survivalcraft" Version="1.8.1.2" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Assets\MiSeaCoresDrinking\" />
    <Folder Include="SpecialFile\" />
  </ItemGroup>

  <Target Name="PostBuild" AfterTargets="PostBuildEvent">
    <Exec Command="setlocal enabledelayedexpansion&#xD;&#xA;if exist &quot;C:\Program Files\7-Zip\7z.exe&quot; (&#xD;&#xA;    set &quot;7ZIP_PATH=C:\Program Files\7-Zip\7z.exe&quot;&#xD;&#xA;    set &quot;OUTPUT_FILE=$(TargetDir)MiSeaCore[$(Configuration)].scmod&quot;&#xD;&#xA;    &#xD;&#xA;    if exist &quot;!OUTPUT_FILE!&quot; del &quot;!OUTPUT_FILE!&quot; /Q&#xD;&#xA;    &#xD;&#xA;    &quot;!7ZIP_PATH!&quot; a -tzip &quot;!OUTPUT_FILE!&quot; ^&#xD;&#xA;        &quot;$(ProjectDir)Assets\&quot; ^&#xD;&#xA;        &quot;$(ProjectDir)SpecialFile\&quot; ^&#xD;&#xA;        &quot;$(ProjectDir)icon.png&quot; ^&#xD;&#xA;        &quot;$(ProjectDir)modinod.json&quot; ^&#xD;&#xA;        &quot;$(TargetPath)&quot; ^&#xD;&#xA;        -r&#xD;&#xA;        &#xD;&#xA;    if %25errorlevel%25 equ 0 (&#xD;&#xA;        echo 成功生成: !OUTPUT_FILE!&#xD;&#xA;    ) else (&#xD;&#xA;        echo 压缩失败，错误代码: %25errorlevel%25&#xD;&#xA;        exit 1&#xD;&#xA;    )&#xD;&#xA;) else (&#xD;&#xA;    echo 未找到7zip，请检查安装路径是否正确&#xD;&#xA;    exit 1&#xD;&#xA;)&#xD;&#xA;endlocal" />
  </Target>

</Project>
